<UserControl x:Class="billiard_management_system.Views.ReportManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:billiard_management_system.Helpers.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1050">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
    </UserControl.Resources>

    <Grid Background="#F1F5F9" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER & BỘ LỌC KHOẢNG THỜI GIAN -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="BÁO CÁO DOANH THU &amp; THỐNG KÊ HOẠT ĐỘNG" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" />
                    <TextBlock Text="Chỉ tổng hợp doanh thu từ hóa đơn đã thanh toán (Paid) • Không cộng hóa đơn chờ (Pending) hoặc đã hủy (Cancelled)"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding FromDate}"
                                materialDesign:HintAssist.Hint="Từ ngày"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Width="130" Padding="8,5" FontSize="12" Margin="0,0,8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}"
                                materialDesign:HintAssist.Hint="Đến ngày"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Width="130" Padding="8,5" FontSize="12" Margin="0,0,8,0" />
                    <Button Command="{Binding FilterReportCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00897B" BorderBrush="#00897B"
                            Height="34" Padding="14,0" FontSize="12" Content="Tổng hợp" Margin="0,0,8,0" />
                    <Button Command="{Binding FilterTodayCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="10,0" FontSize="11.5" Content="Hôm nay" Margin="0,0,6,0" />
                    <Button Command="{Binding FilterLast7DaysCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="10,0" FontSize="11.5" Content="7 ngày" Margin="0,0,6,0" />
                    <Button Command="{Binding FilterCurrentMonthCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="34" Padding="10,0" FontSize="11.5" Content="Tháng này" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- THẺ KPI TỔNG HỢP DOANH THU & HOẠT ĐỘNG -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
            <!-- Tổng doanh thu thực thu (Paid) -->
            <Border Background="White" BorderBrush="#A7F3D0" BorderThickness="1,1,1,4" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH THU (PAID)" FontSize="11" FontWeight="Bold" Foreground="#047857" />
                    <TextBlock Text="{Binding NetRevenue, Converter={StaticResource CurrencyConverter}}"
                               FontSize="20" FontWeight="ExtraBold" Foreground="#059669" Margin="0,4,0,2" />
                    <TextBlock FontSize="11" Foreground="#64748B">
                        <Run Text="TM: " /><Run Text="{Binding CashRevenue, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
                        <Run Text=" • CK: " /><Run Text="{Binding BankTransferRevenue, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Doanh thu tiền giờ bàn -->
            <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1,1,1,4" CornerRadius="10" Padding="14,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU TIỀN BÀN" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                    <TextBlock Text="{Binding TableRevenue, Converter={StaticResource CurrencyConverter}}"
                               FontSize="19" FontWeight="ExtraBold" Foreground="#0284C7" Margin="0,4,0,2" />
                    <TextBlock Text="Tách biệt tiền giờ chơi" FontSize="11" Foreground="#64748B" />
                </StackPanel>
            </Border>

            <!-- Doanh thu sản phẩm F&B -->
            <Border Background="White" BorderBrush="#FDE68A" BorderThickness="1,1,1,4" CornerRadius="10" Padding="14,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU SẢN PHẨM (F&amp;B)" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                    <TextBlock Text="{Binding ProductRevenue, Converter={StaticResource CurrencyConverter}}"
                               FontSize="19" FontWeight="ExtraBold" Foreground="#D97706" Margin="0,4,0,2" />
                    <TextBlock FontSize="11" Foreground="#64748B">
                        <Run Text="Giảm giá HĐ: -" /><Run Text="{Binding TotalDiscount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Số lượng Hóa đơn -->
            <Border Background="White" BorderBrush="#DDD6FE" BorderThickness="1,1,1,4" CornerRadius="10" Padding="14,12" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="HÓA ĐƠN ĐÃ THANH TOÁN" FontSize="11" FontWeight="Bold" Foreground="#6D28D9" />
                    <TextBlock Text="{Binding PaidInvoiceCount}"
                               FontSize="20" FontWeight="ExtraBold" Foreground="#7C3AED" Margin="0,4,0,2" />
                    <TextBlock FontSize="11" Foreground="#64748B">
                        <Run Text="Chờ: " /><Run Text="{Binding PendingInvoiceCount}" FontWeight="SemiBold" />
                        <Run Text=" • Hủy: " /><Run Text="{Binding CancelledInvoiceCount}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Số lượng Phiên chơi -->
            <Border Background="White" BorderBrush="#FECDD3" BorderThickness="1,1,1,4" CornerRadius="10" Padding="14,12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ PHIÊN CHƠI" FontSize="11" FontWeight="Bold" Foreground="#BE123C" />
                    <TextBlock Text="{Binding TotalSessionCount}"
                               FontSize="20" FontWeight="ExtraBold" Foreground="#E11D48" Margin="0,4,0,2" />
                    <TextBlock FontSize="11" Foreground="#64748B">
                        <Run Text="Hoàn tất: " /><Run Text="{Binding CompletedSessionCount}" FontWeight="SemiBold" />
                        <Run Text=" • Đang chơi: " /><Run Text="{Binding ActiveSessionCount}" FontWeight="SemiBold" />
                        <Run Text=" • Hủy: " /><Run Text="{Binding CancelledSessionCount}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- BẢNG CHI TIẾT PHÂN TÍCH & ĐỐI CHIẾU SỐ LIỆU -->
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignFilledTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                    Background="Transparent" BorderThickness="0">

            <!-- Tab 1: Doanh thu theo ngày & Công suất theo bàn -->
            <TabItem Header="📊 DOANH THU THEO NGÀY &amp; HIỆU SUẤT BÀN">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5.5*" />
                        <ColumnDefinition Width="4.5*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="TỔNG HỢP DOANH THU THEO TỪNG NGÀY (CHỈ TÍNH HĐ PAID)"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DailyBreakdown}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày" Binding="{Binding ReportDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Số HĐ Paid" Binding="{Binding PaidInvoiceCount}" Width="85" />
                                    <DataGridTextColumn Header="Tiền bàn" Binding="{Binding TableRevenue, Converter={StaticResource CurrencyConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Tiền F&amp;B" Binding="{Binding ProductRevenue, Converter={StaticResource CurrencyConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Giảm giá" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="Thực thu" Binding="{Binding NetRevenue, Converter={StaticResource CurrencyConverter}}" Width="*" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="THỐNG KÊ HIỆU SUẤT &amp; DOANH THU THEO BÀN"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TableBreakdown}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bàn" Binding="{Binding TableNumber}" Width="65" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Loại bàn" Binding="{Binding TypeName}" Width="*" />
                                    <DataGridTextColumn Header="Số phiên" Binding="{Binding SessionCount}" Width="75" />
                                    <DataGridTextColumn Header="Giờ chơi" Binding="{Binding TotalHoursDisplay}" Width="85" />
                                    <DataGridTextColumn Header="Tổng thu" Binding="{Binding NetRevenue, Converter={StaticResource CurrencyConverter}}" Width="110" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Sản phẩm bán chạy & Đối chiếu hóa đơn Paid -->
            <TabItem Header="🧾 ĐỐI CHIẾU HÓA ĐƠN &amp; TOP SẢN PHẨM F&amp;B">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="THỐNG KÊ SẢN PHẨM BÁN CHẠY (F&amp;B)"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TopProducts}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="110" />
                                    <DataGridTextColumn Header="SL bán" Binding="{Binding TotalQuantitySold}" Width="70" />
                                    <DataGridTextColumn Header="Doanh thu" Binding="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Width="105" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="BẢNG ĐỐI CHIẾU DỮ LIỆU HÓA ĐƠN ĐÃ THANH TOÁN (PAID)"
                                           FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="{Binding ReconciliationStatusText}" FontSize="11.5" FontWeight="Bold" Foreground="#047857" />
                                </Border>
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding PaidInvoicesForReconciliation}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã HĐ" Binding="{Binding InvoiceCode}" Width="145" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Bàn" Binding="{Binding TableNumber}" Width="60" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Thanh toán lúc" Binding="{Binding PaidAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="125" />
                                    <DataGridTextColumn Header="Tiền bàn" Binding="{Binding TableAmount, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="Tiền F&amp;B" Binding="{Binding ServiceAmount, Converter={StaticResource CurrencyConverter}}" Width="95" />
                                    <DataGridTextColumn Header="Giảm giá" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="85" />
                                    <DataGridTextColumn Header="Thực thu" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="*" FontWeight="Bold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
