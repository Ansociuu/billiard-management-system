<UserControl x:Class="billiard_management_system.Views.TableManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:billiard_management_system.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1120"
             Background="#F5F6F8">

    <UserControl.Resources>
        <converters:TableStatusToBrushConverter x:Key="StatusBrushConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:DurationConverter x:Key="DurationConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Background="Transparent" BorderThickness="0">
            <!-- ========================================================================= -->
            <!-- TAB 1: SƠ ĐỒ BÀN CHƠI & VẬN HÀNH PHIÊN (FLOOR PLAN)                        -->
            <!-- ========================================================================= -->
            <TabItem Header="🎱 SƠ ĐỒ VẬN HÀNH BÀN CHƠI">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <!-- Thanh thống kê & bộ lọc -->
                        <RowDefinition Height="Auto" />
                        <!-- Vùng nội dung chính: Danh sách bàn + Chi tiết bàn -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP BAR: THỐNG KÊ VÀ BỘ LỌC -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.06" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Filter theo loại bàn & trạng thái -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Tất cả loại" IsChecked="True" Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterTypeCommand}" CommandParameter="All" Margin="0,0,6,0" />
                                <RadioButton Content="Bàn Pool" Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterTypeCommand}" CommandParameter="1" Margin="0,0,6,0" />
                                <RadioButton Content="Bàn Carom" Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterTypeCommand}" CommandParameter="2" Margin="0,0,6,0" />
                                <RadioButton Content="Bàn 3 Băng" Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterTypeCommand}" CommandParameter="3" Margin="0,0,12,0" />

                                <Border Width="1" Height="22" Background="#E2E8F0" Margin="0,0,12,0" />

                                <Button Content="Tất cả TT" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="All" Height="30" Padding="8,0" FontSize="12" Margin="0,0,4,0" />
                                <Button Content="Trống" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="Available" Height="30" Padding="10,0" FontSize="12" Margin="0,0,4,0" />
                                <Button Content="Đang chơi" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="Occupied" Height="30" Padding="10,0" FontSize="12" Margin="0,0,4,0" />
                                <Button Content="Bảo trì" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="Maintenance" Height="30" Padding="10,0" FontSize="12" />
                            </StackPanel>

                            <!-- Thống kê nhanh & Nút tải lại -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Chip Bàn Trống -->
                                <Border Background="#E8F5E9" CornerRadius="16" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="#2E7D32" Margin="0,0,6,0" />
                                        <TextBlock Text="Trống: " Foreground="#2E7D32" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding AvailableCount}" Foreground="#2E7D32" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Chip Đang Chơi -->
                                <Border Background="#FFEBEE" CornerRadius="16" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="#C62828" Margin="0,0,6,0" />
                                        <TextBlock Text="Đang chơi: " Foreground="#C62828" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding OccupiedCount}" Foreground="#C62828" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Chip Bảo Trì -->
                                <Border Background="#F1F5F9" CornerRadius="16" Padding="10,5" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="#64748B" Margin="0,0,6,0" />
                                        <TextBlock Text="Bảo trì: " Foreground="#475569" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding MaintenanceCount}" Foreground="#475569" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <!-- Nút Refresh -->
                                <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Height="34" Padding="10,0" ToolTip="Làm mới sơ đồ bàn">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Làm mới" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN AREA: LƯỚI BÀN (BÊN TRÁI) + CHI TIẾT & HÓA ĐƠN (BÊN PHẢI) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="385" />
                        </Grid.ColumnDefinitions>

                        <!-- DANH SÁCH BÀN CHƠI (CARD GRID) -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                            <ItemsControl ItemsSource="{Binding FilteredTables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="195" Height="185" Margin="0,0,14,14" CornerRadius="10"
                                                Background="White" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#00897B" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid Margin="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Tiêu đề bàn & Badge trạng thái -->
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding TableNumber}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            CornerRadius="12" Padding="8,3"
                                                            Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">
                                                        <TextBlock Text="{Binding StatusDisplayName}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <!-- Loại bàn & Đơn giá -->
                                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TypeName}" Foreground="#64748B" FontSize="12" />
                                                    <TextBlock Text="{Binding HourlyRate, Converter={StaticResource CurrencyConverter}, StringFormat='{}{0}/giờ'}" 
                                                               Foreground="#00897B" FontSize="11" FontWeight="Medium" />
                                                </StackPanel>

                                                <!-- Nội dung theo trạng thái: Occupied / Available / Maintenance -->
                                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <Border Visibility="{Binding IsOccupied, Converter={StaticResource BoolToVisConverter}}"
                                                            Background="#FEF2F2" CornerRadius="6" Padding="8,6">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="ClockOutline" Foreground="#DC2626" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                <TextBlock Text="{Binding ElapsedTime, Converter={StaticResource DurationConverter}}" 
                                                                           Foreground="#DC2626" FontSize="15" FontWeight="Bold" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding CurrentSession.StartTime, StringFormat='Vào: {0:HH:mm}'}" 
                                                                       Foreground="#991B1B" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisConverter}}"
                                                            Background="#F0FDF4" CornerRadius="6" Padding="8,10">
                                                        <TextBlock Text="Sẵn sàng đón khách" Foreground="#166534" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" />
                                                    </Border>

                                                    <Border Visibility="{Binding IsMaintenance, Converter={StaticResource BoolToVisConverter}}"
                                                            Background="#F1F5F9" CornerRadius="6" Padding="8,10">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="WrenchOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Đang bảo trì" Foreground="#475569" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <Grid Grid.Row="3" Margin="0,6,0,0">
                                                    <TextBlock Text="Nhấp để thao tác →" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- BẢNG ĐIỀU KHIỂN & HÓA ĐƠN CHI TIẾT (BÊN PHẢI) -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.07" ShadowDepth="2" />
                            </Border.Effect>

                            <Grid Visibility="{Binding HasSelectedTable, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- HEADER BÀN ĐANG CHỌN -->
                                <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Bàn " FontSize="22" FontWeight="Bold" Foreground="#1E293B" />
                                                <TextBlock Text="{Binding SelectedTable.TableNumber}" FontSize="22" FontWeight="Bold" Foreground="#00897B" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedTable.TypeName}" Foreground="#64748B" FontSize="13" />
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="10,4"
                                                Background="{Binding SelectedTable.Status, Converter={StaticResource StatusBrushConverter}}">
                                            <TextBlock Text="{Binding SelectedTable.StatusDisplayName}" Foreground="White" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TRƯỜNG HỢP 1: BÀN TRỐNG (AVAILABLE) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" 
                                            Visibility="{Binding CanStartSession, Converter={StaticResource BoolToVisConverter}}">
                                    <materialDesign:PackIcon Kind="TableCheck" Width="64" Height="64" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                    <TextBlock Text="Bàn hiện đang sẵn sàng!" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bấm nút bên dưới để mở bàn và bắt đầu tính giờ" Foreground="#64748B" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,24" />
                                    
                                    <Button Command="{Binding StartSessionCommand}" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                            Background="#00897B" BorderBrush="#00897B"
                                            Height="48" FontSize="15" FontWeight="Bold" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="MỞ BÀN (BẮT ĐẦU CHƠI)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding SetMaintenanceCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#64748B" BorderBrush="#CBD5E1"
                                            Height="38" FontSize="13">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="WrenchOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Chuyển sang trạng thái Bảo trì" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- TRƯỜNG HỢP 1B: BÀN ĐANG BẢO TRÌ (MAINTENANCE) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsSelectedTableMaintenance, Converter={StaticResource BoolToVisConverter}}">
                                    <materialDesign:PackIcon Kind="WrenchClock" Width="64" Height="64" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                    <TextBlock Text="Bàn đang trong quá trình Bảo trì" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Center" />
                                    <TextBlock Text="Bàn tạm ngưng đón khách để vệ sinh / bảo dưỡng nỉ và bi." Foreground="#64748B" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,24" />

                                    <Button Command="{Binding SetAvailableFromMaintenanceCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#2E7D32" BorderBrush="#2E7D32"
                                            Height="46" FontSize="14" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="HOÀN TẤT BẢO TRÌ (MỞ LẠI BÀN)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- TRƯỜNG HỢP 2: BÀN ĐANG CHƠI (OCCUPIED) -->
                                <Grid Grid.Row="1" Visibility="{Binding CanCheckout, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ĐỒNG HỒ & TÍNH TIỀN GIỜ -->
                                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Thời gian chơi" FontSize="11" Foreground="#64748B" />
                                                <TextBlock Text="{Binding CurrentDuration, Converter={StaticResource DurationConverter}}" 
                                                           FontSize="20" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="Tiền giờ tạm tính" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding CurrentTableAmount, Converter={StaticResource CurrencyConverter}}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="#00897B" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- CHUYỂN BÀN NHANH -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailableSwitchTargets}"
                                                  SelectedItem="{Binding TargetSwitchTable, Mode=TwoWay}"
                                                  DisplayMemberPath="TableNumber"
                                                  materialDesign:HintAssist.Hint="Chọn bàn trống để chuyển..."
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Padding="10,6" FontSize="12" Margin="0,0,8,0" />
                                        <Button Grid.Column="1"
                                                Command="{Binding SwitchTableCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Height="34" Padding="12,0" FontSize="12" Content="Đổi bàn" />
                                    </Grid>

                                    <!-- DANH SÁCH MÓN ĐÃ GỌI -->
                                    <GroupBox Grid.Row="2" Header="Dịch vụ &amp; Món đã gọi" Style="{StaticResource MaterialDesignGroupBox}"
                                              materialDesign:ColorZoneAssist.Mode="Standard" Margin="0,0,0,8">
                                        <ListBox ItemsSource="{Binding CurrentSessionProducts}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding ProductName}" FontWeight="Medium" Foreground="#1E293B" />
                                                            <TextBlock Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" FontSize="11" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" 
                                                                   FontWeight="Bold" Foreground="#00897B" VerticalAlignment="Center" Margin="8,0" />
                                                        <Button Grid.Column="3" Style="{StaticResource MaterialDesignIconButton}" 
                                                                Command="{Binding DataContext.RemoveProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="24" Height="24" Padding="0" Foreground="#EF4444" ToolTip="Xóa món">
                                                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </GroupBox>

                                    <!-- GỌI MÓN NHANH -->
                                    <Expander Grid.Row="3" Header="Thêm đồ uống / Dịch vụ nhanh" IsExpanded="False" Margin="0,0,0,6">
                                        <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableProducts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,6">
                                                            <Grid>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="12" />
                                                                    <TextBlock Text="{Binding Price, Converter={StaticResource CurrencyConverter}}" FontSize="11" Foreground="#00897B" />
                                                                </StackPanel>
                                                                <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                        Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Height="28" Padding="10,0" Content="+ Thêm" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </Grid>

                                <!-- FOOTER THANH TOÁN (KHI ĐANG CHƠI) -->
                                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                        Visibility="{Binding CanCheckout, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="TỔNG THANH TOÁN:" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#1E293B" />
                                            <TextBlock Text="{Binding CurrentTotalAmount, Converter={StaticResource CurrencyConverter}}" 
                                                       FontSize="22" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Button Command="{Binding CheckoutCommand}" 
                                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                                Background="#DC2626" BorderBrush="#DC2626"
                                                Height="48" FontSize="15" FontWeight="Bold">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="THANH TOÁN &amp; TRẢ BÀN" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 2: QUẢN LÝ DANH SÁCH BÀN & LOẠI BÀN (CRUD TABLES & TABLE TYPES)       -->
            <!-- ========================================================================= -->
            <TabItem Header="⚙️ QUẢN LÝ BÀN &amp; LOẠI BÀN"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: QUẢN LÝ DANH SÁCH BÀN BILLIARD (TABLES) -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,14,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TableFurniture" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Danh sách Bàn Billiard (Tables)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button HorizontalAlignment="Right"
                                        Command="{Binding PrepareNewTableCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32" Padding="12,0" FontSize="12" Content="+ Nhập bàn mới" />
                            </Grid>

                            <!-- Bảng danh sách bàn -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding AllTablesIncludingInactive}"
                                      SelectedItem="{Binding SelectedManageTable, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      BorderThickness="0"
                                      RowHeight="42"
                                      Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding TableId}" Width="50" />
                                    <DataGridTextColumn Header="Số bàn" Binding="{Binding TableNumber}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Loại bàn" Binding="{Binding TypeName}" Width="*" />
                                    <DataGridTextColumn Header="Giá áp dụng" Binding="{Binding HourlyRate, Converter={StaticResource CurrencyConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplayName}" Width="105" />
                                    <DataGridTextColumn Header="Kinh doanh" Binding="{Binding ActiveDisplayName}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Form Thêm/Sửa Bàn -->
                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding TableFormTitle}" FontSize="14" FontWeight="Bold" Foreground="#00897B" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FormTableNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Số bàn (vd: P04) *"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="13" Margin="0,0,12,0" />

                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TableTypes}"
                                                  SelectedValue="{Binding FormTableTypeId, Mode=TwoWay}"
                                                  SelectedValuePath="TableTypeId"
                                                  DisplayMemberPath="TypeName"
                                                  materialDesign:HintAssist.Hint="Loại bàn *"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" Margin="0,0,12,0" />

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding AllowedTableStatuses}"
                                                  SelectedItem="{Binding FormTableStatus, Mode=TwoWay}"
                                                  materialDesign:HintAssist.Hint="Trạng thái"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" Margin="0,0,12,0" />

                                        <CheckBox Grid.Column="3"
                                                  Content="Đang sử dụng"
                                                  IsChecked="{Binding FormTableIsActive, Mode=TwoWay}"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,4" FontWeight="SemiBold" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding ToggleTableActiveCommand}"
                                                Visibility="{Binding IsTableEditMode, Converter={StaticResource BoolToVisConverter}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#D97706" BorderBrush="#D97706"
                                                Height="36" Padding="14,0" Margin="0,0,10,0"
                                                Content="{Binding ToggleTableActiveButtonText}" />

                                        <Button Command="{Binding SaveTableCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="#00897B" BorderBrush="#00897B"
                                                Height="36" Padding="18,0" FontWeight="Bold"
                                                Content="{Binding TableSaveButtonText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CỘT PHẢI: QUẢN LÝ LOẠI BÀN (TABLE TYPES) -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShapeOutline" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Loại Bàn (TableTypes)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button HorizontalAlignment="Right"
                                        Command="{Binding PrepareNewTableTypeCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="32" Padding="10,0" FontSize="12" Content="+ Thêm loại mới" />
                            </Grid>

                            <!-- Danh sách loại bàn -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding AllTableTypesIncludingInactive}"
                                      SelectedItem="{Binding SelectedManageTableType, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      BorderThickness="0"
                                      RowHeight="42"
                                      Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding TableTypeId}" Width="45" />
                                    <DataGridTextColumn Header="Tên loại bàn" Binding="{Binding TypeName}" Width="*" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplayName}" Width="115" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Form Thêm/Sửa Loại bàn -->
                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding TypeFormTitle}" FontSize="14" FontWeight="Bold" Foreground="#00897B" Margin="0,0,0,10" />

                                    <TextBox Text="{Binding FormTypeName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Tên loại bàn (vd: Bàn Snooker) *"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,10" />

                                    <TextBox Text="{Binding FormTypeDescription, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Mô tả chi tiết loại bàn"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,12" />

                                    <Grid>
                                        <CheckBox Content="Đang áp dụng"
                                                  IsChecked="{Binding FormTypeIsActive, Mode=TwoWay}"
                                                  VerticalAlignment="Center" FontWeight="SemiBold" />

                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding SaveTableTypeCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="#00897B" BorderBrush="#00897B"
                                                Height="36" Padding="16,0" FontWeight="Bold"
                                                Content="{Binding TypeSaveButtonText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- TAB 3: QUẢN LÝ QUY TẮC GIÁ BÀN & KHUYẾN MÃI (TABLE PRICING RULES - #15)   -->
            <!-- ========================================================================= -->
            <TabItem Header="💰 QUY TẮC GIÁ BÀN &amp; KHUYẾN MÃI"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH BỘ LỌC & THỐNG KÊ QUY TẮC GIÁ -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Bộ lọc theo Loại quy tắc & Trạng thái -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Tất cả quy tắc" IsChecked="True"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRuleTypeCommand}" CommandParameter="All" Margin="0,0,6,0" />
                                <RadioButton Content="💵 Giá cơ bản (BaseRate)"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRuleTypeCommand}" CommandParameter="BaseRate" Margin="0,0,6,0" />
                                <RadioButton Content="🎁 Khuyến mãi (Promotion)"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRuleTypeCommand}" CommandParameter="Promotion" Margin="0,0,12,0" />

                                <Border Width="1" Height="22" Background="#E2E8F0" Margin="0,0,12,0" />

                                <Button Content="Đang áp dụng" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterRuleStatusCommand}" CommandParameter="Active" Height="30" Padding="10,0" FontSize="12" Margin="0,0,4,0" />
                                <Button Content="Ngừng áp dụng" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterRuleStatusCommand}" CommandParameter="Inactive" Height="30" Padding="10,0" FontSize="12" Margin="0,0,4,0" />
                                <Button Content="Tất cả TT" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding FilterRuleStatusCommand}" CommandParameter="All" Height="30" Padding="8,0" FontSize="12" />
                            </StackPanel>

                            <!-- Thống kê & Nút Tạo quy tắc mới -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#DCFCE7" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Giá chuẩn: " Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActiveBaseRulesCount}" Foreground="#15803D" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FEF3C7" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Khuyến mãi: " Foreground="#B45309" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActivePromotionsCount}" Foreground="#B45309" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="14" Padding="10,5" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tạm ngưng: " Foreground="#475569" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InactiveRulesCount}" Foreground="#475569" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding PrepareNewPricingRuleCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#00897B" BorderBrush="#00897B"
                                        Height="36" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlusCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Tạo quy tắc giá" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- NỘI DUNG CHÍNH: BẢNG QUY TẮC GIÁ (TRÁI) + FORM CẤU HÌNH (PHẢI) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <!-- DANH SÁCH QUY TẮC GIÁ BÀN & KHUYẾN MÃI -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Danh sách Quy tắc Giá bàn &amp; Chương trình Khuyến mãi (TablePricingRules)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredPricingRules}"
                                          SelectedItem="{Binding SelectedPricingRule, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          BorderThickness="0"
                                          RowHeight="44">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding PricingRuleId}" Width="45" />
                                        <DataGridTextColumn Header="Tên quy tắc / KM" Binding="{Binding RuleName}" Width="*" FontWeight="Bold" />
                                        <DataGridTextColumn Header="Loại bàn" Binding="{Binding TypeName}" Width="125" />
                                        <DataGridTextColumn Header="Phân loại" Binding="{Binding RuleTypeDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Ngày áp dụng" Binding="{Binding DayTypeDisplay}" Width="135" />
                                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeSlotDisplay}" Width="120" />
                                        <DataGridTextColumn Header="Giá / Mức giảm" Binding="{Binding ValueDisplay}" Width="115" FontWeight="Bold" />
                                        <DataGridTextColumn Header="Thời hạn hiệu lực" Binding="{Binding EffectiveDateDisplay}" Width="155" />
                                        <DataGridTextColumn Header="Ưu tiên" Binding="{Binding Priority}" Width="65" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplayName}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- FORM TẠO / CHỈNH SỬA QUY TẮC GIÁ & KHUYẾN MÃI -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.06" ShadowDepth="2" />
                            </Border.Effect>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TagMultipleOutline" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RuleFormTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Thông báo lỗi nếu có -->
                                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Width="320" />
                                        </StackPanel>
                                    </Border>

                                    <TextBox Text="{Binding FormRuleName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Tên quy tắc giá / chương trình khuyến mãi *"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding TableTypes}"
                                                  SelectedValue="{Binding FormRuleTableTypeId, Mode=TwoWay}"
                                                  SelectedValuePath="TableTypeId"
                                                  DisplayMemberPath="TypeName"
                                                  materialDesign:HintAssist.Hint="Loại bàn áp dụng *"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" Margin="0,0,12,0" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding FormRulePriorityText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Độ ưu tiên *"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="13" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AllowedRuleTypes}"
                                                  SelectedItem="{Binding FormRuleType, Mode=TwoWay}"
                                                  materialDesign:HintAssist.Hint="Loại quy tắc (BaseRate/Promotion)*"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" Margin="0,0,10,0" />

                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AllowedDayTypes}"
                                                  SelectedItem="{Binding FormRuleDayType, Mode=TwoWay}"
                                                  materialDesign:HintAssist.Hint="Ngày áp dụng (Weekday/Weekend...)*"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" />
                                    </Grid>

                                    <!-- KHUNG GIỜ ÁP DỤNG (START TIME - END TIME) -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <CheckBox Content="Áp dụng toàn thời gian trong ngày (00:00 - 24:00)"
                                                      IsChecked="{Binding FormRuleIsAllDay, Mode=TwoWay}"
                                                      FontWeight="SemiBold" Foreground="#0F172A" />

                                            <Grid Margin="0,10,0,0"
                                                  Visibility="{Binding IsCustomTimeSlot, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0"
                                                         Text="{Binding FormRuleStartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Giờ bắt đầu (HH:mm) *"
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         FontSize="13" Margin="0,0,10,0" />

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding FormRuleEndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="Giờ kết thúc (HH:mm) *"
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         FontSize="13" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- GIÁ CƠ BẢN (HIỂN THỊ KHI RULE TYPE = BaseRate) -->
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                            Visibility="{Binding IsBaseRateRule, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBox Text="{Binding FormRuleHourlyRateText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Đơn giá giờ cơ bản (VNĐ / giờ, > 0) *"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="14" FontWeight="Bold" Foreground="#15803D" />
                                    </Border>

                                    <!-- KHUYẾN MÃI (HIỂN THỊ KHI RULE TYPE = Promotion) -->
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                            Visibility="{Binding IsPromotionRule, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AllowedDiscountTypes}"
                                                      SelectedItem="{Binding FormRuleDiscountType, Mode=TwoWay}"
                                                      materialDesign:HintAssist.Hint="Hình thức giảm *"
                                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                      FontSize="13" Margin="0,0,10,0" />

                                            <TextBox Grid.Column="1"
                                                     Text="{Binding FormRuleDiscountValueText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="{Binding DiscountValueHint}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     FontSize="14" FontWeight="Bold" Foreground="#B45309" />
                                        </Grid>
                                    </Border>

                                    <!-- KHOẢNG NGÀY HIỆU LỰC (EFFECTIVE FROM - EFFECTIVE TO) -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DatePicker SelectedDate="{Binding FormRuleEffectiveFrom, Mode=TwoWay}"
                                                        materialDesign:HintAssist.Hint="Ngày bắt đầu hiệu lực (EffectiveFrom) *"
                                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                                        FontSize="13" Margin="0,0,0,10" />

                                            <CheckBox Content="Giới hạn ngày kết thúc hiệu lực (EffectiveTo)"
                                                      IsChecked="{Binding FormRuleHasEndDate, Mode=TwoWay}"
                                                      FontWeight="Medium" Margin="0,0,0,6" />

                                            <DatePicker SelectedDate="{Binding FormRuleEffectiveTo, Mode=TwoWay}"
                                                        Visibility="{Binding FormRuleHasEndDate, Converter={StaticResource BoolToVisConverter}}"
                                                        materialDesign:HintAssist.Hint="Ngày kết thúc hiệu lực (EffectiveTo >= EffectiveFrom) *"
                                                        Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                                        FontSize="13" />
                                        </StackPanel>
                                    </Border>

                                    <CheckBox Content="Đang hoạt động (Dùng để tính tiền tự động)"
                                              IsChecked="{Binding FormRuleIsActive, Mode=TwoWay}"
                                              FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,16" />

                                    <Button Command="{Binding SavePricingRuleCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#00897B" BorderBrush="#00897B"
                                            Height="42" FontSize="13" FontWeight="Bold" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding RuleSaveButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding TogglePricingRuleActiveCommand}"
                                            Visibility="{Binding IsRuleEditMode, Converter={StaticResource BoolToVisConverter}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Foreground="#D97706" BorderBrush="#D97706"
                                            Height="36" FontSize="12"
                                            Content="{Binding ToggleRuleActiveButtonText}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
