<Window x:Class="billiard_management_system.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:billiard_management_system.Helpers"
        mc:Ignorable="d"
        Title="Đăng Nhập - Hệ Thống Quản Lý Quán Billiard" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <!-- Background subtle accent -->
        <Border Margin="24" Background="White" CornerRadius="16" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.25" ShadowDepth="8" />
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- LOGO & TIÊU ĐỀ -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Width="64" Height="64" Background="#00897B" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Billiards" Width="36" Height="36" Foreground="White" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BILLIARD CLUB" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock Text="Phần mềm Quản lý Quán Billiard" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- THÔNG BÁO LỖI NẾU CÓ -->
                <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- TÊN ĐĂNG NHẬP -->
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Tên đăng nhập" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         FontSize="14" Margin="0,0,0,16" />

                <!-- MẬT KHẨU -->
                <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                             materialDesign:HintAssist.Hint="Mật khẩu"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             FontSize="14" Margin="0,0,0,24" />

                <!-- NÚT ĐĂNG NHẬP -->
                <Button Command="{Binding LoginCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Background="#00897B" BorderBrush="#00897B"
                        Height="46" FontSize="15" FontWeight="Bold" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="ĐĂNG NHẬP" Visibility="{Binding IsNotBusy, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                     Value="0" IsIndeterminate="True" 
                                     Width="24" Height="24" Foreground="White"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>
                </Button>

                <!-- THÔNG TIN GỢI Ý ĐĂNG NHẬP CHO TEST -->
                <Border Background="#F8FAFC" CornerRadius="8" Padding="10">
                    <StackPanel>
                        <TextBlock Text="💡 Tài khoản mặc định:" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Text="• Admin: admin / Admin@123" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                        <TextBlock Text="• Thu ngân: staff01 / Admin@123" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>

