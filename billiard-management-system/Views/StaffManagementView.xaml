<UserControl x:Class="billiard_management_system.Views.StaffManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:billiard_management_system.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F1F5F9">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Background="Transparent" BorderThickness="0">
            <!-- ================================================================== -->
            <!-- TAB 1: QUẢN LÝ TÀI KHOẢN & HỒ SƠ NHÂN VIÊN (USERS & EMPLOYEES)     -->
            <!-- ================================================================== -->
            <TabItem Header="👥 TÀI KHOẢN &amp; HỒ SƠ NHÂN VIÊN">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH TÌM KIẾM, BỘ LỌC & THỐNG KÊ NHANH -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Ô tìm kiếm -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍 Tìm theo tên, username, SĐT, chức vụ..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="12,8" FontSize="13" VerticalAlignment="Center" />

                            <!-- Bộ lọc Vai trò & Trạng thái -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                <RadioButton Content="Tất cả" IsChecked="True"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRoleCommand}" CommandParameter="All" Margin="0,0,6,0" />
                                <RadioButton Content="Quản trị (Admin)"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRoleCommand}" CommandParameter="1" Margin="0,0,6,0" />
                                <RadioButton Content="Nhân viên (Staff)"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterRoleCommand}" CommandParameter="2" Margin="0,0,12,0" />

                                <Border Width="1" Height="24" Background="#E2E8F0" Margin="0,0,12,0" />

                                <Button Content="Đang hoạt động" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="Active"
                                        Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0" />
                                <Button Content="Đã khóa" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="Locked"
                                        Height="30" Padding="10,0" FontSize="12" Margin="0,0,6,0" />
                                <Button Content="Tất cả TT" Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding FilterStatusCommand}" CommandParameter="All"
                                        Height="30" Padding="8,0" FontSize="12" />
                            </StackPanel>

                            <!-- Thống kê & Nút thao tác -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#E0F2FE" CornerRadius="14" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tổng: " Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TotalStaffCount}" Foreground="#0369A1" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#DCFCE7" CornerRadius="14" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Hoạt động: " Foreground="#15803D" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActiveStaffCount}" Foreground="#15803D" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#FEE2E2" CornerRadius="14" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Đã khóa: " Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding LockedStaffCount}" Foreground="#B91C1C" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding PrepareNewUserCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#00897B" BorderBrush="#00897B"
                                        Height="36" Padding="12,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Tạo tài khoản mới" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="36" Padding="10,0" ToolTip="Tải lại danh sách">
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- NỘI DUNG CHÍNH: BẢNG DANH SÁCH (TRÁI) + FORM HỒ SƠ (PHẢI) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: DANH SÁCH TÀI KHOẢN & HỒ SƠ NHÂN VIÊN -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="BadgeAccountHorizontalOutline" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Danh sách Tài khoản &amp; Hồ sơ Nhân sự" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding FilteredUsers}"
                                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          Background="White"
                                          BorderThickness="0"
                                          RowHeight="48">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="55" />
                                        <DataGridTextColumn Header="Tài khoản" Binding="{Binding Username}" Width="115" FontWeight="Bold" />
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" Width="95" />
                                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding PositionDisplay}" Width="140" />
                                        <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="115" />
                                        <DataGridTextColumn Header="Ngày vào làm" Binding="{Binding HireDateDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusDisplayName}" Width="125" FontWeight="SemiBold" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- CỘT PHẢI: FORM THÊM MỚI / CẬP NHẬT TÀI KHOẢN & HỒ SƠ -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.06" ShadowDepth="2" />
                            </Border.Effect>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- TIÊU ĐỀ FORM -->
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountEditOutline" Width="24" Height="24" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding FormHeaderTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- THÔNG BÁO LỖI VALIDATION NẾU CÓ -->
                                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Width="320" />
                                        </StackPanel>
                                    </Border>

                                    <!-- PHẦN 1: THÔNG TIN TÀI KHOẢN ĐĂNG NHẬP (USERS) -->
                                    <TextBlock Text="1. Thông tin Tài khoản &amp; Phân quyền (Users)" FontSize="12" FontWeight="Bold" Foreground="#00897B" Margin="0,0,0,10" />

                                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode}"
                                             materialDesign:HintAssist.Hint="Tên đăng nhập (Username) *"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,12" />

                                    <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                                 helpers:PasswordBoxHelper.BoundPassword="{Binding FormPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="{Binding PasswordHintText}"
                                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                                 FontSize="13" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding Roles}"
                                                  SelectedValue="{Binding FormRoleId, Mode=TwoWay}"
                                                  SelectedValuePath="RoleId"
                                                  DisplayMemberPath="RoleName"
                                                  materialDesign:HintAssist.Hint="Vai trò hệ thống (Role) *"
                                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                  FontSize="13" Margin="0,0,16,0" />

                                        <CheckBox Grid.Column="1"
                                                  Content="Kích hoạt"
                                                  IsChecked="{Binding FormIsActive, Mode=TwoWay}"
                                                  VerticalAlignment="Bottom"
                                                  FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4" />
                                    </Grid>

                                    <!-- PHẦN 2: THÔNG TIN HỒ SƠ NHÂN VIÊN (EMPLOYEES) -->
                                    <TextBlock Text="2. Hồ sơ Nhân sự (Employees)" FontSize="12" FontWeight="Bold" Foreground="#00897B" Margin="0,6,0,10" />

                                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Họ và tên nhân viên *"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FormPosition, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Chức vụ / Vị trí"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="13" Margin="0,0,8,0" />

                                        <DatePicker Grid.Column="1"
                                                    SelectedDate="{Binding FormHireDate, Mode=TwoWay}"
                                                    materialDesign:HintAssist.Hint="Ngày vào làm"
                                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                                                    FontSize="13" Margin="8,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Số điện thoại"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="13" Margin="0,0,8,0" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Địa chỉ Email"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 FontSize="13" Margin="8,0,0,0" />
                                    </Grid>

                                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Địa chỉ liên hệ"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             FontSize="13" Margin="0,0,0,20" />

                                    <!-- NÚT LƯU CHÍNH -->
                                    <Button Command="{Binding SaveUserCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#00897B" BorderBrush="#00897B"
                                            Height="44" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding SaveButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- CÁC NÚT THAO TÁC PHỤ KHI ĐANG CHỈNH SỬA -->
                                    <Grid Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Command="{Binding ToggleActiveStatusCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#D97706" BorderBrush="#D97706"
                                                Height="38" Margin="0,0,6,0" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountLockOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding ToggleStatusButtonText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Command="{Binding DeleteUserCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Foreground="#DC2626" BorderBrush="#DC2626"
                                                Height="38" Margin="6,0,0,0" FontSize="12">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Xóa / Ngừng SD" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================== -->
            <!-- TAB 2: PHÂN QUYỀN VAI TRÒ HỆ THỐNG (ROLES & PERMISSIONS MATRIX)    -->
            <!-- ================================================================== -->
            <TabItem Header="🛡️ PHÂN QUYỀN VAI TRÒ (RBAC)">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- DANH SÁCH VAI TRÒ BÊN TRÁI -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ShieldAccountOutline" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Vai trò Hệ thống (Roles)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Chọn một vai trò bên dưới để xem và cấu hình các quyền truy cập chức năng."
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <ListBox ItemsSource="{Binding Roles}"
                                     SelectedItem="{Binding SelectedRoleForRbac, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Width="270">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoleName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- DANH SÁCH QUYỀN CHI TIẾT CỦA VAI TRÒ ĐANG CHỌN -->
                    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Danh mục Quyền hạn cho vai trò: " FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding SelectedRoleForRbac.RoleName}" FontSize="16" FontWeight="ExtraBold" Foreground="#00897B" />
                                </StackPanel>
                                <TextBlock Text="Các thao tác nghiệp vụ ở cả giao diện (UI) và tầng dịch vụ (Service) đều kiểm tra danh sách quyền này."
                                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RolePermissionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" Background="#F8FAFC">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsEditable}"
                                                              VerticalAlignment="Center" Margin="0,0,14,0" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PermissionName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PermissionCode}" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="Lưu ý: Vai trò Admin mặc định sở hữu toàn quyền quản trị và không thể bị thu hồi quyền."
                                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />

                                    <Button HorizontalAlignment="Right"
                                            Command="{Binding SaveRolePermissionsCommand}"
                                            IsEnabled="{Binding CanEditSelectedRolePermissions}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#00897B" BorderBrush="#00897B"
                                            Height="40" Padding="20,0" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="LƯU CẤU HÌNH PHÂN QUYỀN" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================== -->
            <!-- TAB 3: NHẬT KÝ THAO TÁC HỆ THỐNG (AUDIT LOGS - ISSUE #23)          -->
            <!-- ================================================================== -->
            <TabItem Header="🛡️ NHẬT KÝ HỆ THỐNG (AUDIT LOGS)"
                     Visibility="{Binding CanViewAuditLogs, Converter={StaticResource BoolToVisConverter}}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- THANH BỘ LỌC NHẬT KÝ HỆ THỐNG -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0"
                                            SelectedDate="{Binding AuditFromDate, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="Từ ngày"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Padding="10,7" FontSize="12" Margin="0,0,8,0" />

                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding AuditToDate, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="Đến ngày"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Padding="10,7" FontSize="12" Margin="0,0,10,0" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding AuditSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="🔍 Tìm hành động, người thực hiện, mô tả..."
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="10,7" FontSize="12" Margin="0,0,10,0" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding RefreshAuditLogsCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#00897B" BorderBrush="#00897B"
                                            Height="34" Padding="14,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Tra cứu nhật ký" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ClearAuditFiltersCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="34" Padding="12,0" Content="Đặt lại" FontSize="12" />
                                </StackPanel>

                                <Border Grid.Column="4" Background="#E0F2FE" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bản ghi: " Foreground="#0369A1" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TotalAuditLogsCount}" Foreground="#0369A1" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bộ lọc nhanh theo nhóm hành động -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Nhóm thao tác:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <RadioButton Content="Tất cả" IsChecked="True"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="All" Margin="0,0,6,0" />
                                <RadioButton Content="Đăng nhập / Xác thực"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="AUTH" Margin="0,0,6,0" />
                                <RadioButton Content="Mở / Đóng phiên &amp; Bàn"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="SESSION" Margin="0,0,6,0" />
                                <RadioButton Content="Hóa đơn &amp; Thanh toán"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="INVOICE" Margin="0,0,6,0" />
                                <RadioButton Content="Thay đổi giá &amp; Dịch vụ"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="PRICE_PRODUCT" Margin="0,0,6,0" />
                                <RadioButton Content="Tài khoản &amp; Phân quyền"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="USER_RBAC" Margin="0,0,6,0" />
                                <RadioButton Content="Cảnh báo / Từ chối quyền"
                                             Style="{StaticResource MaterialDesignChoiceChipRadioButton}"
                                             Command="{Binding FilterAuditCategoryCommand}" CommandParameter="SECURITY" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BẢNG DANH SÁCH NHẬT KÝ (TRÁI) + CHI TIẾT TRƯỚC/SAU THAY ĐỔI (PHẢI) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6.3*" />
                            <ColumnDefinition Width="3.7*" />
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI: BẢNG AUDIT LOGS -->
                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="14" Margin="0,0,14,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                            </Border.Effect>
                            <DataGrid ItemsSource="{Binding AuditLogs}"
                                      SelectedItem="{Binding SelectedAuditLog, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      Background="White"
                                      BorderThickness="0"
                                      RowHeight="42"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="135" />
                                    <DataGridTextColumn Header="Người thực hiện" Binding="{Binding ActorDisplay}" Width="165" FontWeight="SemiBold" />
                                    <DataGridTemplateColumn Header="Hành động" Width="155">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding ActionBadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Action}" Foreground="{Binding ActionBadgeForeground}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Đối tượng" Binding="{Binding EntityDisplay}" Width="125" />
                                    <DataGridTextColumn Header="Mô tả chi tiết" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- CỘT PHẢI: CHI TIẾT BẢN GHI & DỮ LIỆU TRƯỚC/SAU KHI THAY ĐỔI -->
                        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Visibility="{Binding HasSelectedAuditLog, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="ShieldSearch" Width="22" Height="22" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="CHI TIẾT NHẬT KÝ TRUY VẾT" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Mã nhật ký:" Foreground="#64748B" FontSize="12" />
                                                <TextBlock Text="{Binding SelectedAuditLog.AuditLogId, StringFormat=#\{0\}}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Thời điểm:" Foreground="#64748B" FontSize="12" />
                                                <TextBlock Text="{Binding SelectedAuditLog.CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Người thực hiện:" Foreground="#64748B" FontSize="12" />
                                                <TextBlock Text="{Binding SelectedAuditLog.ActorDisplay}" FontWeight="Bold" Foreground="#00897B" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="Mã hành động:" Foreground="#64748B" FontSize="12" />
                                                <TextBlock Text="{Binding SelectedAuditLog.Action}" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Đối tượng tác động:" Foreground="#64748B" FontSize="12" />
                                                <TextBlock Text="{Binding SelectedAuditLog.EntityDisplay}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="MÔ TẢ NGHIỆP VỤ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedAuditLog.Description}" FontSize="12.5" Foreground="#1E293B" TextWrapping="Wrap" />
                                    </Border>

                                    <TextBlock Text="DỮ LIỆU TRƯỚC KHI THAY ĐỔI (OLD VALUES)" FontSize="11" FontWeight="Bold" Foreground="#B45309" Margin="0,0,0,4" />
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                        <TextBox Text="{Binding SelectedAuditLog.OldValuesDisplay, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontFamily="Consolas" FontSize="11.5" Foreground="#92400E"
                                                 TextWrapping="Wrap" />
                                    </Border>

                                    <TextBlock Text="DỮ LIỆU SAU KHI THAY ĐỔI (NEW VALUES)" FontSize="11" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4" />
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <TextBox Text="{Binding SelectedAuditLog.NewValuesDisplay, Mode=OneWay}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontFamily="Consolas" FontSize="11.5" Foreground="#166534"
                                                 TextWrapping="Wrap" />
                                    </Border>

                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10,8">
                                        <TextBlock Text="🔒 Chính sách bảo mật: Mật khẩu, PasswordHash và khóa bí mật luôn được tự động ẩn ([REDACTED]) trước khi lưu vào AuditLogs."
                                                   FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================== -->
            <!-- TAB 4: KIỂM THỬ TÍCH HỢP & THEO DÕI LỖI (TESTING - ISSUE #24)      -->
            <!-- ================================================================== -->
            <TabItem Header="🧪 KIỂM THỬ TÍCH HỢP &amp; THEO DÕI LỖI"
                     Visibility="{Binding CanViewAuditLogs, Converter={StaticResource BoolToVisConverter}}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <!-- HEADER & NÚT CHẠY KIỂM THỬ TÍCH HỢP -->
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="BỘ KIỂM THỬ TÍCH HỢP TOÀN LUỒNG NGHIỆP VỤ (SYSTEM INTEGRATION TEST SUITE)"
                                           FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="{Binding IntegrationTestSummaryText}"
                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding RunIntegrationTestsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#00897B" BorderBrush="#00897B"
                                    Height="42" Padding="20,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="CHẠY KIỂM THỬ TÍCH HỢP TOÀN HỆ THỐNG" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- KẾT QUẢ CHẠY CÁC KỊCH BẢN KIỂM THỬ TÍCH HỢP (TC-01 -> TC-05) -->
                    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="CheckDecagram" Width="20" Height="20" Foreground="#00897B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="1. KẾT QUẢ KIỂM THỬ CÁC LUỒNG NGHIỆP VỤ, PHÂN QUYỀN RBAC &amp; BẢO TOÀN GIÁ LỊCH SỬ"
                                           FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding IntegrationTestResults}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      Background="White"
                                      BorderThickness="0"
                                      RowHeight="42"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã TC" Binding="{Binding TestCode}" Width="75" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Nhóm kiểm thử" Binding="{Binding Category}" Width="155" />
                                    <DataGridTextColumn Header="Kịch bản kiểm thử" Binding="{Binding TestName}" Width="280" FontWeight="SemiBold" />
                                    <DataGridTemplateColumn Header="Trạng thái" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeBackground}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RetestStatus}" Foreground="{Binding StatusBadgeForeground}" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Phụ trách" Binding="{Binding Owner}" Width="95" />
                                    <DataGridTextColumn Header="Thời gian (ms)" Binding="{Binding DurationMs}" Width="95" />
                                    <DataGridTextColumn Header="Kết quả thực tế chi tiết" Binding="{Binding ActualResult}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- DANH SÁCH LỖI ĐÃ PHÁT HIỆN, NGƯỜI PHỤ TRÁCH VÀ KẾT QUẢ KIỂM THỬ LẠI -->
                    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="BugCheckOutline" Width="20" Height="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="2. DANH SÁCH LỖI ĐÃ GHI NHẬN, NGƯỜI PHỤ TRÁCH &amp; KẾT QUẢ KIỂM THỬ LẠI (DEFECT &amp; RETEST LOG)"
                                           FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding DefectTrackingRecords}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      Background="White"
                                      BorderThickness="0"
                                      RowHeight="42"
                                      FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã lỗi" Binding="{Binding DefectId}" Width="80" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Issue" Binding="{Binding RelatedIssue}" Width="80" />
                                    <DataGridTextColumn Header="Phân hệ" Binding="{Binding Module}" Width="135" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Mô tả vấn đề phát hiện" Binding="{Binding Description}" Width="280" />
                                    <DataGridTextColumn Header="Giải pháp khắc phục" Binding="{Binding RootCauseAndFix}" Width="*" />
                                    <DataGridTextColumn Header="Người phụ trách" Binding="{Binding Owner}" Width="150" />
                                    <DataGridTextColumn Header="Kết quả kiểm thử lại" Binding="{Binding RetestResult}" Width="240" FontWeight="Bold" Foreground="#15803D" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
