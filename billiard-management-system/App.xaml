<Application x:Class="billiard_management_system.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:billiard_management_system"
             xmlns:converters="clr-namespace:billiard_management_system.Helpers.Converters"
             xmlns:vm="clr-namespace:billiard_management_system.ViewModels"
             xmlns:views="clr-namespace:billiard_management_system.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- CONVERTERS DÙNG TOÀN CỤC -->
            <converters:TableStatusToBrushConverter x:Key="TableStatusToBrushConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />
            <converters:DurationConverter x:Key="DurationConverter" />
            <converters:MenuActiveConverter x:Key="MenuActiveConverter" />
            <converters:NotificationTypeToBrushConverter x:Key="NotificationTypeToBrushConverter" />
            <converters:SafeImageUrlConverter x:Key="SafeImageUrlConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- DATA TEMPLATES: TỰ ĐỘNG BIND VIEW THEO VIEWMODEL -->
            <DataTemplate DataType="{x:Type vm:TableManagementViewModel}">
                <views:TableManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}">
                <views:ProductManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StaffManagementViewModel}">
                <views:StaffManagementView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MenuPlaceholderViewModel}">
                <views:MenuPlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
